# ==============================================================================
# eShopBD Backend Server Environment Configuration
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Client URLs (for CORS whitelist)
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection URL (Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Option A - Local PostgreSQL (Default):
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/eshopbd_db?schema=public"
#
# Option B - Supabase (Cloud):
# DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Option C - Coolify Hosted PostgreSQL:
# DATABASE_URL="postgresql://postgres:[coolify-password]@[coolify-host]:5432/eshopbd_db?schema=public"
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eshopbd_db?schema=public"

# ------------------------------------------------------------------------------
# JWT Authentication Secrets
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="eshopbd_jwt_access_super_secret_key_2026_change_in_prod"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="eshopbd_jwt_refresh_super_secret_key_2026_change_in_prod"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Redis Cache & Session Configuration (Optional / Next Phase)
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
